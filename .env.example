# Supabase project URL. The lab executes SQL only when both variables are set.
# The app still builds and renders without them, and shows a configuration notice.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key. This is client-safe. Supabase labels it "publishable".
# Never put a secret key or the service_role key in this file or in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_me
